# BASE DE DATOS - Neon (Siempre usar Neon para persistencia en ambos entornos)
# Obtén tu URL de Neon en: https://console.neon.tech/
DATABASE_URL=postgresql+pg8000://usuario:password@ep-neon-host.us-east-2.aws.neon.tech/neondb?sslmode=require

# SEGURIDAD JWT
SECRET_KEY=tu_secret_key_super_segura_cambiala_por_una_real_generala_con_python_secrets
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# DIRECTORIO DE SUBIDA DE ARCHIVOS
UPLOAD_DIR=./uploads

# ENTORNO (development/production)
ENVIRONMENT=development
